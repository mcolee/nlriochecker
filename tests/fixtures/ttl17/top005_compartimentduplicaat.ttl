        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1350.0 2000.0 1400.1 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
