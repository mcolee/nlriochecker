    gwsw:hasAspect :PutE_ori .
:PutE_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1350.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Mof rdf:type gwsw:Inspectieput ; rdfs:label "M0003" ;
    gwsw:hasAspect :Mof_ori .
:Mof_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1400.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Mof1 rdf:type gwsw:Inspectieput ; rdfs:label "M0003  c1" ;
    gwsw:hasAspect :Mof1_ori .
:Mof1_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1400.1 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:L1 rdf:type gwsw:GemengdRiool ; rdfs:label "1" ;
    gwsw:hasAspect :L1_ori .
:L1_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L1_b , :L1_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1050.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L1_b rdf:type gwsw:BeginpuntLeiding .
:L1_e rdf:type gwsw:EindpuntLeiding .
:L1_b gwsw:hasConnection :PutA_ori .
:L1_e gwsw:hasConnection :PutB_ori .
:L2 rdf:type gwsw:GemengdRiool ; rdfs:label "2" ;
    gwsw:hasAspect :L2_ori .
:L2_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L2_b , :L2_e ;
