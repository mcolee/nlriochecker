:V1 rdf:type gwsw:GemengdRiool ; rdfs:label "V1" ;
    gwsw:hasAspect :V1_ori .
:V1 gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 400 ] ,
    [ rdf:type gwsw:HoogteLeiding ; gwsw:hasValue 400 ] ,
    [ rdf:type gwsw:MateriaalLeiding ; gwsw:hasReference gwsw:Beton ] ,
    [ rdf:type gwsw:VormLeiding ; gwsw:hasReference gwsw:Rond ] .
:V1_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :V1_b , :V1_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1050.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:V1_b rdf:type gwsw:BeginpuntLeiding .
:V1_e rdf:type gwsw:EindpuntLeiding .
:V1_b gwsw:hasConnection :KruisA1_ori .
:V1_e gwsw:hasConnection :KruisB1_ori .
