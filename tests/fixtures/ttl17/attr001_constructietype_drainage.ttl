@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix gwsw: <http://data.gwsw.nl/1.7/totaal/> .
@prefix :     <http://example.org/toets#> .

# Minimale klassenhierarchie, zodat de fixture zonder de volle ontologie werkt.
gwsw:Inspectieput rdfs:subClassOf gwsw:Rioolput .
gwsw:LozePut rdfs:subClassOf gwsw:Rioolput .
gwsw:Lozingsput rdfs:subClassOf gwsw:Rioolput .
gwsw:Overstortput rdfs:subClassOf gwsw:Rioolput .
gwsw:Rioolput rdfs:subClassOf gwsw:Put .
gwsw:Putorientatie rdfs:subClassOf gwsw:Knooppunt .
gwsw:Compartimentorientatie rdfs:subClassOf gwsw:Knooppunt .
gwsw:Bouwwerkorientatie rdfs:subClassOf gwsw:Knooppunt .
gwsw:Leidingorientatie rdfs:subClassOf gwsw:Verbinding .
gwsw:GemengdRiool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Hemelwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Vuilwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Infiltratieriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Overstortleiding rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:VrijvervalRioolleiding rdfs:subClassOf gwsw:Rioolleiding .
gwsw:Rioolleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Persleiding rdfs:subClassOf gwsw:MechanischeTransportleiding .
gwsw:MechanischeTransportleiding rdfs:subClassOf gwsw:Transportleiding .
gwsw:Transportleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Rioolgemaal rdfs:subClassOf gwsw:Gemaal .
gwsw:Uitlaatconstructie rdfs:subClassOf gwsw:Bouwwerk .
gwsw:Bergbezinkbassin rdfs:subClassOf gwsw:Bouwwerk .
gwsw:Valput rdfs:subClassOf gwsw:Rioolput .
gwsw:Duiker rdfs:subClassOf gwsw:Leiding .
gwsw:Zinker rdfs:subClassOf gwsw:VrijvervalRioolleiding .
# Drain en Aansluitleiding hangen in de GWSW-ontologie rechtstreeks onder Leiding en
# niet onder VrijvervalRioolleiding (geverifieerd in de gebundelde ontologie); de
# prelude zei dat van Drain tot issue #82 verkeerd.
gwsw:Drain rdfs:subClassOf gwsw:Leiding .
gwsw:Aansluitleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Sloot rdfs:subClassOf gwsw:Oppervlaktewater .

# DEFECT: streng HW is een hemelwaterriool van PVC Ø65 en valt onder de PVC-ondergrens van 100 mm; DT is een DT-riool van dezelfde maat en hetzelfde materiaal en valt binnen het drainagebereik dat vóór het materiaalbereik gaat; DIT is een DIT-riool van Ø45 en valt onder dat drainagebereik (issue #86)

gwsw:DIT_riool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:DT_riool rdfs:subClassOf gwsw:VrijvervalRioolleiding .

:PutA rdf:type gwsw:Inspectieput ; rdfs:label "A" ;
    gwsw:hasAspect :PutA_ori .
:PutA gwsw:hasAspect [ rdf:type gwsw:BreedtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:LengtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:MateriaalPut ; gwsw:hasReference gwsw:Beton ] ,
    [ rdf:type gwsw:HoogtePut ; gwsw:hasValue 1500 ] .
:PutA_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1000.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutA_ori gwsw:hasConnection :PutA_maa .
:PutA_maa rdf:type gwsw:Maaiveldorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue 10.0 ] .
:PutB rdf:type gwsw:Inspectieput ; rdfs:label "B" ;
    gwsw:hasAspect :PutB_ori .
:PutB gwsw:hasAspect [ rdf:type gwsw:BreedtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:LengtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:MateriaalPut ; gwsw:hasReference gwsw:Beton ] ,
    [ rdf:type gwsw:HoogtePut ; gwsw:hasValue 1500 ] .
:PutB_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1050.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutB_ori gwsw:hasConnection :PutB_maa .
:PutB_maa rdf:type gwsw:Maaiveldorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue 10.0 ] .
:PutC rdf:type gwsw:Inspectieput ; rdfs:label "C" ;
    gwsw:hasAspect :PutC_ori .
:PutC gwsw:hasAspect [ rdf:type gwsw:BreedtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:LengtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:MateriaalPut ; gwsw:hasReference gwsw:Beton ] ,
    [ rdf:type gwsw:HoogtePut ; gwsw:hasValue 1500 ] .
:PutC_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1100.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutC_ori gwsw:hasConnection :PutC_maa .
:PutC_maa rdf:type gwsw:Maaiveldorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue 10.0 ] .
:PutD rdf:type gwsw:Inspectieput ; rdfs:label "D" ;
    gwsw:hasAspect :PutD_ori .
:PutD gwsw:hasAspect [ rdf:type gwsw:BreedtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:LengtePut ; gwsw:hasValue 1000 ] ,
    [ rdf:type gwsw:MateriaalPut ; gwsw:hasReference gwsw:Beton ] ,
    [ rdf:type gwsw:HoogtePut ; gwsw:hasValue 1500 ] .
:PutD_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1150.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutD_ori gwsw:hasConnection :PutD_maa .
:PutD_maa rdf:type gwsw:Maaiveldorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue 10.0 ] .
:DT rdf:type gwsw:DT_riool ; rdfs:label "DT" ;
    gwsw:hasAspect :DT_ori .
:DT gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 65 ] ,
    [ rdf:type gwsw:HoogteLeiding ; gwsw:hasValue 65 ] ,
    [ rdf:type gwsw:MateriaalLeiding ; gwsw:hasReference gwsw:PVC ] ,
    [ rdf:type gwsw:VormLeiding ; gwsw:hasReference gwsw:Rond ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 50.0 ] ,
    [ rdf:type gwsw:Begindatum ; gwsw:hasValue "1980-01-01"^^xsd:date ] .
:DT_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :DT_b , :DT_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1050.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:DT_b rdf:type gwsw:BeginpuntLeiding .
:DT_e rdf:type gwsw:EindpuntLeiding .
:DT_b gwsw:hasConnection :PutA_ori .
:DT_e gwsw:hasConnection :PutB_ori .
:HW rdf:type gwsw:Hemelwaterriool ; rdfs:label "HW" ;
    gwsw:hasAspect :HW_ori .
:HW gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 65 ] ,
    [ rdf:type gwsw:HoogteLeiding ; gwsw:hasValue 65 ] ,
    [ rdf:type gwsw:MateriaalLeiding ; gwsw:hasReference gwsw:PVC ] ,
    [ rdf:type gwsw:VormLeiding ; gwsw:hasReference gwsw:Rond ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 50.0 ] ,
    [ rdf:type gwsw:Begindatum ; gwsw:hasValue "1980-01-01"^^xsd:date ] .
:HW_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :HW_b , :HW_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1050.0 2000.0 1100.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:HW_b rdf:type gwsw:BeginpuntLeiding .
:HW_e rdf:type gwsw:EindpuntLeiding .
:HW_b gwsw:hasConnection :PutB_ori .
:HW_e gwsw:hasConnection :PutC_ori .
:DIT rdf:type gwsw:DIT_riool ; rdfs:label "DIT" ;
    gwsw:hasAspect :DIT_ori .
:DIT gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 45 ] ,
    [ rdf:type gwsw:HoogteLeiding ; gwsw:hasValue 45 ] ,
    [ rdf:type gwsw:MateriaalLeiding ; gwsw:hasReference gwsw:PVC ] ,
    [ rdf:type gwsw:VormLeiding ; gwsw:hasReference gwsw:Rond ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 50.0 ] ,
    [ rdf:type gwsw:Begindatum ; gwsw:hasValue "1980-01-01"^^xsd:date ] .
:DIT_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :DIT_b , :DIT_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1100.0 2000.0 1150.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:DIT_b rdf:type gwsw:BeginpuntLeiding .
:DIT_e rdf:type gwsw:EindpuntLeiding .
:DIT_b gwsw:hasConnection :PutC_ori .
:DIT_e gwsw:hasConnection :PutD_ori .
