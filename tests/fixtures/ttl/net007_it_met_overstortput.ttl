@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix gwsw: <http://data.gwsw.nl/1.6/totaal/> .
@prefix :     <http://example.org/toets#> .

# Minimale klassenhierarchie, zodat de fixture zonder de volle ontologie werkt.
gwsw:Inspectieput rdfs:subClassOf gwsw:Rioolput .
gwsw:Overstortput rdfs:subClassOf gwsw:Rioolput .
gwsw:Rioolput     rdfs:subClassOf gwsw:Put .
gwsw:GemengdRiool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Overstortleiding rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:VrijvervalRioolleiding rdfs:subClassOf gwsw:Rioolleiding .
gwsw:Rioolleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Persleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Rioolgemaal  rdfs:subClassOf gwsw:Gemaal .
gwsw:Hemelwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Infiltratieriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .


# DEFECT: geen; zelfde als net007_it_zonder_drempel, maar het IT-deelstelsel loost via
# een Overstortput met Overstortleiding -- zoals overstorten op de De Wolden-export
# staan (BO-34, open punt 6) -- in plaats van via een los Overstortdrempel-object.
# NET-007 hoort die overstortvorm te herkennen en zwijgt daarom. Zie issue #42.

:PutA rdf:type gwsw:Inspectieput ; rdfs:label "A" ;
    gwsw:hasAspect :PutA_ori .
:PutA_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1000.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutB rdf:type gwsw:Inspectieput ; rdfs:label "B" ;
    gwsw:hasAspect :PutB_ori .
:PutB_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1050.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:Gemaal1 rdf:type gwsw:Rioolgemaal ; rdfs:label "G" ;
    gwsw:hasAspect :Gemaal1_ori .
:Gemaal1_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1100.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:L1 rdf:type gwsw:GemengdRiool ; rdfs:label "1" ;
    gwsw:hasAspect :L1_ori .
:L1_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L1_b , :L1_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1050.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L1_b rdf:type gwsw:BeginpuntLeiding .
:L1_e rdf:type gwsw:EindpuntLeiding .
:L1_b gwsw:hasConnection :PutA_ori .
:L1_e gwsw:hasConnection :PutB_ori .

:L2 rdf:type gwsw:GemengdRiool ; rdfs:label "2" ;
    gwsw:hasAspect :L2_ori .
:L2_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L2_b , :L2_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1050.0 2000.0 1100.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L2_b rdf:type gwsw:BeginpuntLeiding .
:L2_e rdf:type gwsw:EindpuntLeiding .
:L2_b gwsw:hasConnection :PutB_ori .
:L2_e gwsw:hasConnection :Gemaal1_ori .

:PutC rdf:type gwsw:Inspectieput ; rdfs:label "C" ;
    gwsw:hasAspect :PutC_ori .
:PutC_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>2000.0 3000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutD rdf:type gwsw:Inspectieput ; rdfs:label "D" ;
    gwsw:hasAspect :PutD_ori .
:PutD_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>2050.0 3000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:L8 rdf:type gwsw:Infiltratieriool ; rdfs:label "8" ;
    gwsw:hasAspect :L8_ori .
:L8_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L8_b , :L8_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">2000.0 3000.0 2050.0 3000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L8_b rdf:type gwsw:BeginpuntLeiding .
:L8_e rdf:type gwsw:EindpuntLeiding .
:L8_b gwsw:hasConnection :PutC_ori .
:L8_e gwsw:hasConnection :PutD_ori .

# De overstort van het IT-deelstelsel: een Overstortput met een Overstortleiding, geen
# los Overstortdrempel-object.
:OverstortE rdf:type gwsw:Overstortput ; rdfs:label "E" ;
    gwsw:hasAspect :OverstortE_ori .
:OverstortE_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>2100.0 3000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:L9 rdf:type gwsw:Overstortleiding ; rdfs:label "9" ;
    gwsw:hasAspect :L9_ori .
:L9_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L9_b , :L9_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">2050.0 3000.0 2100.0 3000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L9_b rdf:type gwsw:BeginpuntLeiding .
:L9_e rdf:type gwsw:EindpuntLeiding .
:L9_b gwsw:hasConnection :PutD_ori .
:L9_e gwsw:hasConnection :OverstortE_ori .
