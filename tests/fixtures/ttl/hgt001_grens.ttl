:Grens100_ori gwsw:hasConnection :Grens100_maa .
:Grens100_maa rdf:type gwsw:Maaiveldorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Maaiveldhoogte ; gwsw:hasValue 10.1 ] .
