@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix gwsw: <http://data.gwsw.nl/1.6/totaal/> .
@prefix :     <http://example.org/toets#> .

# Minimale klassenhierarchie, zodat de fixture zonder de volle ontologie werkt.
gwsw:Inspectieput rdfs:subClassOf gwsw:Rioolput .
gwsw:Rioolput     rdfs:subClassOf gwsw:Put .
gwsw:Putorientatie rdfs:subClassOf gwsw:Knooppunt .
gwsw:Leidingorientatie rdfs:subClassOf gwsw:Verbinding .
gwsw:Persleiding rdfs:subClassOf gwsw:MechanischeTransportleiding .
gwsw:MechanischeTransportleiding rdfs:subClassOf gwsw:Transportleiding .
gwsw:Transportleiding rdfs:subClassOf gwsw:Leiding .

# Twee mechanische leidingen (Z en A), zodat een test kan bewijzen dat
# `_schrijf_mechanisch` ze in URI-sortering wegschrijft in plaats van in de
# willekeurige volgorde van de frozenset `mechanisch`.

:PutA rdf:type gwsw:Inspectieput ; rdfs:label "A" ;
    gwsw:hasAspect :PutA_ori .
:PutA_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1000.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutB rdf:type gwsw:Inspectieput ; rdfs:label "B" ;
    gwsw:hasAspect :PutB_ori .
:PutB_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1050.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:L_Z rdf:type gwsw:Persleiding ; rdfs:label "Z" ;
    gwsw:hasAspect :L_Z_ori .
:L_Z_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L_Z_b , :L_Z_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1050.0 2000.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L_Z_b rdf:type gwsw:BeginpuntLeiding .
:L_Z_e rdf:type gwsw:EindpuntLeiding .
:L_Z_b gwsw:hasConnection :PutA_ori .
:L_Z_e gwsw:hasConnection :PutB_ori .

:PutC rdf:type gwsw:Inspectieput ; rdfs:label "C" ;
    gwsw:hasAspect :PutC_ori .
:PutC_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1000.0 2050.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:PutD rdf:type gwsw:Inspectieput ; rdfs:label "D" ;
    gwsw:hasAspect :PutD_ori .
:PutD_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1050.0 2050.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:L_A rdf:type gwsw:Persleiding ; rdfs:label "A" ;
    gwsw:hasAspect :L_A_ori .
:L_A_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L_A_b , :L_A_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2050.0 1050.0 2050.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L_A_b rdf:type gwsw:BeginpuntLeiding .
:L_A_e rdf:type gwsw:EindpuntLeiding .
:L_A_b gwsw:hasConnection :PutC_ori .
:L_A_e gwsw:hasConnection :PutD_ori .
