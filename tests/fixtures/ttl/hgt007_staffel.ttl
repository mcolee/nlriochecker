@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix gwsw: <http://data.gwsw.nl/1.6/totaal/> .
@prefix :     <http://example.org/toets#> .

# Minimale klassenhierarchie, zodat de fixture zonder de volle ontologie werkt.
gwsw:Inspectieput rdfs:subClassOf gwsw:Rioolput .
gwsw:Rioolput rdfs:subClassOf gwsw:Put .
gwsw:Putorientatie rdfs:subClassOf gwsw:Knooppunt .
gwsw:Leidingorientatie rdfs:subClassOf gwsw:Verbinding .
gwsw:GemengdRiool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Hemelwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Vuilwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:VrijvervalRioolleiding rdfs:subClassOf gwsw:Rioolleiding .
gwsw:Rioolleiding rdfs:subClassOf gwsw:Leiding .

# Vijf strengen langs een keten putten P1..P6 op de x-as. Elk hangt aan zijn eigen
# BOB's; de putten ankeren alleen de geometrie.
#
# L1: Vuilwaterriool 200 mm, 100 m, verval 0,20 m -> 1:500. Onder de staffel (200 mm
#     -> 1:250) te vlak: DEFECT. Onder een vlakke 1:1000 juist steil genoeg: geen melding.
# L2: GemengdRiool 800 mm, 90 m, verval 0,10 m -> 1:900. Staffel >650 mm -> 1:1000; net
#     steil genoeg, geen melding.
# L3: Hemelwaterriool 200 mm, vlak. Buiten de rol vuilwater: geen melding.
# L4: Vuilwaterriool zonder diameter, wel verval. Geen staffeltrede: niet getoetst.
# L5: Vuilwaterriool 300 mm zonder BOB's. Niet getoetst.

:P1 rdf:type gwsw:Inspectieput ; rdfs:label "P1" ; gwsw:hasAspect :P1_ori .
:P1_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>0.0 0.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:P2 rdf:type gwsw:Inspectieput ; rdfs:label "P2" ; gwsw:hasAspect :P2_ori .
:P2_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>100.0 0.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:P3 rdf:type gwsw:Inspectieput ; rdfs:label "P3" ; gwsw:hasAspect :P3_ori .
:P3_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>200.0 0.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:P4 rdf:type gwsw:Inspectieput ; rdfs:label "P4" ; gwsw:hasAspect :P4_ori .
:P4_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>300.0 0.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:P5 rdf:type gwsw:Inspectieput ; rdfs:label "P5" ; gwsw:hasAspect :P5_ori .
:P5_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>400.0 0.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:P6 rdf:type gwsw:Inspectieput ; rdfs:label "P6" ; gwsw:hasAspect :P6_ori .
:P6_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>500.0 0.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .

:L1 rdf:type gwsw:Vuilwaterriool ; rdfs:label "L1" ; gwsw:hasAspect :L1_ori .
:L1 gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 200 ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 100.0 ] .
:L1_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L1_b , :L1_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">0.0 0.0 100.0 0.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L1_b rdf:type gwsw:BeginpuntLeiding ; gwsw:hasConnection :P1_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobBeginpuntLeiding ; gwsw:hasValue 8.60 ] .
:L1_e rdf:type gwsw:EindpuntLeiding ; gwsw:hasConnection :P2_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobEindpuntLeiding ; gwsw:hasValue 8.40 ] .

:L2 rdf:type gwsw:GemengdRiool ; rdfs:label "L2" ; gwsw:hasAspect :L2_ori .
:L2 gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 800 ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 90.0 ] .
:L2_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L2_b , :L2_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">100.0 0.0 200.0 0.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L2_b rdf:type gwsw:BeginpuntLeiding ; gwsw:hasConnection :P2_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobBeginpuntLeiding ; gwsw:hasValue 8.40 ] .
:L2_e rdf:type gwsw:EindpuntLeiding ; gwsw:hasConnection :P3_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobEindpuntLeiding ; gwsw:hasValue 8.30 ] .

:L3 rdf:type gwsw:Hemelwaterriool ; rdfs:label "L3" ; gwsw:hasAspect :L3_ori .
:L3 gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 200 ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 100.0 ] .
:L3_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L3_b , :L3_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">200.0 0.0 300.0 0.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L3_b rdf:type gwsw:BeginpuntLeiding ; gwsw:hasConnection :P3_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobBeginpuntLeiding ; gwsw:hasValue 8.30 ] .
:L3_e rdf:type gwsw:EindpuntLeiding ; gwsw:hasConnection :P4_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobEindpuntLeiding ; gwsw:hasValue 8.30 ] .

:L4 rdf:type gwsw:Vuilwaterriool ; rdfs:label "L4" ; gwsw:hasAspect :L4_ori .
:L4 gwsw:hasAspect [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 100.0 ] .
:L4_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L4_b , :L4_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">300.0 0.0 400.0 0.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L4_b rdf:type gwsw:BeginpuntLeiding ; gwsw:hasConnection :P4_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobBeginpuntLeiding ; gwsw:hasValue 8.30 ] .
:L4_e rdf:type gwsw:EindpuntLeiding ; gwsw:hasConnection :P5_ori ;
    gwsw:hasAspect [ rdf:type gwsw:BobEindpuntLeiding ; gwsw:hasValue 8.20 ] .

:L5 rdf:type gwsw:Vuilwaterriool ; rdfs:label "L5" ; gwsw:hasAspect :L5_ori .
:L5 gwsw:hasAspect [ rdf:type gwsw:BreedteLeiding ; gwsw:hasValue 300 ] ,
    [ rdf:type gwsw:LengteLeiding ; gwsw:hasValue 100.0 ] .
:L5_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L5_b , :L5_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">400.0 0.0 500.0 0.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L5_b rdf:type gwsw:BeginpuntLeiding ; gwsw:hasConnection :P5_ori .
:L5_e rdf:type gwsw:EindpuntLeiding ; gwsw:hasConnection :P6_ori .
