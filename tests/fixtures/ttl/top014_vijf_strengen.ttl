@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix gwsw: <http://data.gwsw.nl/1.6/totaal/> .
@prefix :     <http://example.org/toets#> .

# Minimale klassenhierarchie, zodat de fixture zonder de volle ontologie werkt.
gwsw:Inspectieput rdfs:subClassOf gwsw:Rioolput .
gwsw:LozePut rdfs:subClassOf gwsw:Rioolput .
gwsw:Lozingsput rdfs:subClassOf gwsw:Rioolput .
gwsw:Overstortput rdfs:subClassOf gwsw:Rioolput .
gwsw:Rioolput rdfs:subClassOf gwsw:Put .
gwsw:Putorientatie rdfs:subClassOf gwsw:Knooppunt .
gwsw:Leidingorientatie rdfs:subClassOf gwsw:Verbinding .
gwsw:GemengdRiool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Hemelwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Vuilwaterriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Infiltratieriool rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:Overstortleiding rdfs:subClassOf gwsw:VrijvervalRioolleiding .
gwsw:VrijvervalRioolleiding rdfs:subClassOf gwsw:Rioolleiding .
gwsw:Rioolleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Persleiding rdfs:subClassOf gwsw:Leiding .
gwsw:Rioolgemaal rdfs:subClassOf gwsw:Gemaal .

# DEFECT: op put A sluiten vijf strengen aan

:PutA rdf:type gwsw:Inspectieput ; rdfs:label "A" ;
    gwsw:hasAspect :PutA_ori .
:PutA_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1000.0 2000.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Put1 rdf:type gwsw:Inspectieput ; rdfs:label "P1" ;
    gwsw:hasAspect :Put1_ori .
:Put1_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1010.0 2020.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Put2 rdf:type gwsw:Inspectieput ; rdfs:label "P2" ;
    gwsw:hasAspect :Put2_ori .
:Put2_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1020.0 2030.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Put3 rdf:type gwsw:Inspectieput ; rdfs:label "P3" ;
    gwsw:hasAspect :Put3_ori .
:Put3_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1030.0 2040.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Put4 rdf:type gwsw:Inspectieput ; rdfs:label "P4" ;
    gwsw:hasAspect :Put4_ori .
:Put4_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1040.0 2050.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:Put5 rdf:type gwsw:Inspectieput ; rdfs:label "P5" ;
    gwsw:hasAspect :Put5_ori .
:Put5_ori rdf:type gwsw:Putorientatie ;
    gwsw:hasAspect [ rdf:type gwsw:Punt ;
        gwsw:hasValue "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>1050.0 2060.0</gml:pos></gml:Point>"^^geo:gmlLiteral ] .
:L1 rdf:type gwsw:GemengdRiool ; rdfs:label "1" ;
    gwsw:hasAspect :L1_ori .
:L1_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L1_b , :L1_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1010.0 2020.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L1_b rdf:type gwsw:BeginpuntLeiding .
:L1_e rdf:type gwsw:EindpuntLeiding .
:L1_b gwsw:hasConnection :PutA_ori .
:L1_e gwsw:hasConnection :Put1_ori .
:L2 rdf:type gwsw:GemengdRiool ; rdfs:label "2" ;
    gwsw:hasAspect :L2_ori .
:L2_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L2_b , :L2_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1020.0 2030.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L2_b rdf:type gwsw:BeginpuntLeiding .
:L2_e rdf:type gwsw:EindpuntLeiding .
:L2_b gwsw:hasConnection :PutA_ori .
:L2_e gwsw:hasConnection :Put2_ori .
:L3 rdf:type gwsw:GemengdRiool ; rdfs:label "3" ;
    gwsw:hasAspect :L3_ori .
:L3_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L3_b , :L3_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1030.0 2040.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L3_b rdf:type gwsw:BeginpuntLeiding .
:L3_e rdf:type gwsw:EindpuntLeiding .
:L3_b gwsw:hasConnection :PutA_ori .
:L3_e gwsw:hasConnection :Put3_ori .
:L4 rdf:type gwsw:GemengdRiool ; rdfs:label "4" ;
    gwsw:hasAspect :L4_ori .
:L4_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L4_b , :L4_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1040.0 2050.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L4_b rdf:type gwsw:BeginpuntLeiding .
:L4_e rdf:type gwsw:EindpuntLeiding .
:L4_b gwsw:hasConnection :PutA_ori .
:L4_e gwsw:hasConnection :Put4_ori .
:L5 rdf:type gwsw:GemengdRiool ; rdfs:label "5" ;
    gwsw:hasAspect :L5_ori .
:L5_ori rdf:type gwsw:Leidingorientatie ;
    gwsw:hasPart :L5_b , :L5_e ;
    gwsw:hasAspect [ rdf:type gwsw:Lijn ;
        gwsw:hasValue "<gml:LineString xmlns:gml=\"http://www.opengis.net/gml\"><gml:posList srsDimension=\"2\">1000.0 2000.0 1050.0 2060.0</gml:posList></gml:LineString>"^^geo:gmlLiteral ] .
:L5_b rdf:type gwsw:BeginpuntLeiding .
:L5_e rdf:type gwsw:EindpuntLeiding .
:L5_b gwsw:hasConnection :PutA_ori .
:L5_e gwsw:hasConnection :Put5_ori .
