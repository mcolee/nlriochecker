# Claude Code — persoonlijke instellingen, niet delen
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
# Met een leidende slash, om dezelfde reden als /uitvoer/ hieronder: zonder die
# slash sluit de regel ook een gelijknamige map dieper in de boom uit.
/htmlcov/
/dist/

# Uitvoer van de pijplijn
/uitvoer/

# Invoerdata en referentiedocumenten (groot, niet in versiebeheer)
data/*
# Het checkregister is geen invoerdata maar het functionele contract van deze
# codebase: register.py, scripts/dekkingsmatrix.py, de testsuite en de
# registerijking van de dekkingmapping lezen het alle vier. Zonder versiebeheer
# kan geen enkele geautomatiseerde controle zien dat het is opgeschoven.
# Een uitzondering werkt alleen als de map zelf niet is uitgesloten; vandaar
# 'data/*' hierboven in plaats van 'data/'.
!data/checkregister-*.md
# De vocabulaire-index is geen invoerdata maar een afgeleide van de GWSW-ontologie:
# per GWSW-naam zijn rdf:type's en zijn directe superklassen, en niets meer.
# tests/test_gwsw_vocabulaire.py draait erop, en zonder versiebeheer sloeg die test op
# de CI-runner vrijwel volledig over -- dan bewaakt hij niets. De ontologie zelf blijft
# buiten versiebeheer (2,6 MB); de index is 285 kB. Licentie is geen bezwaar: de
# GWSW-ontologie staat onder CC0. De afweging staat als BO-32 in docs/beslislog.md.
# Bijwerken doe je met scripts/maak_gwsw_index.py, nooit met de hand.
# Ook hier geldt: een uitzondering werkt alleen omdat hierboven 'data/*' staat en
# niet 'data/'; met 'data/' is de map zelf uitgesloten en kijkt git er niet in.
!data/gwsw-vocabulaire-index.json
